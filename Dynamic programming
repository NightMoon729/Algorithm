#### 数位DP
``` cpp
i64 digitDP(i64 low, i64 high, i64 target) {
    std::string low_s = std::format("{:b}", low), high_s = std::format("{:b}", high);
    int n = high_s.size();
    int diff_lh = n - low_s.size();
    std::vector memo(n, std::vector<i64>(target + 1, -1));
    auto dfs = [&](this auto&& dfs, int i, int cnt, bool limit_low, bool limit_high) -> i64 {
        if (cnt > target) return 0; // 不合法
        if (i == n) return cnt == target;
        if (!limit_low && !limit_high && memo[i][cnt] >= 0) return memo[i][cnt];
        int lo = limit_low && i >= diff_lh ? low_s[i - diff_lh] - '0' : 0;
        int hi = limit_high ? high_s[i] - '0' : 1;
        i64 res = 0;
        int d = lo;
        if (limit_low && i < diff_lh) { // 如果下界有限制
            res = dfs(i + 1, 0, true, false);
            d = 1;
        }
        for (; d <= hi; d++) // 从d枚举到i
            res += dfs(i + 1, cnt + (d == 1), limit_low && d == lo, limit_high && d == hi);
        if (!limit_low && !limit_high) memo[i][cnt] = res;
        return res;
    };
    return dfs(0, 0, true, true);
}
```


#### 高维前缀和 (从子集转移)
``` cpp
std::vector<int> sos_dp(std::vector<int>& a) {
    int mx = ranges::max(a);
    int w = bit_width((uint32_t) mx); // 二进制长度上限
    std::vector<int> f(1 << w);
    for (int x : a) f[x]++; // 初始值
    for (int i = 0; i < w; i++) {
        for (int s = 0; s < (1 << w); s++) {
            s |= 1 << i; // 优化：快速跳到 i 位是 1 的 s
            f[s] += f[s ^ (1 << i)];
        }
    }
    return f;
}
