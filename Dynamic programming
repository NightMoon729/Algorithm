#### 多重背包
``` cpp
// 二进制枚举优化多重背包
i64 boundedKnapsack(std::vector<int> num, std::vector<int>& w, std::vector<int>& v, int maxW) {
    std::vector<i64> f(maxW + 1, 0);
    for (int i = 0; i < num.size(); i++) {
        for (int p = 1; num[i] > 0; p *= 2) { // 由于二进制枚举能构成所有数所以可以优化这一维
            int k = std::min(p, num[i]);
            for (int j = maxW; j >= w[i] * k; j--)
                f[j] = std::max(f[j], f[j - w[i] * k] + 1LL * v[i] * k);
            num[i] -= k;
        }
    }
    return f[maxW];
} // O(n * maxW * log(sum(num)))

// 单调队列优化
i64 boundedKnapsack(std::vector<int>& stocks, std::vector<int>& values, std::vector<int>& weights, int maxW) {
    std::vector<i64> f(maxW + 1);
    std::deque<std::pair<i64, int>> q;
    for (int i = 0; i < stocks.size(); i++) {
        int num = stocks[i], v = values[i], w = weights[i];
        for (int rem = 0; rem < w; rem++) {
            q.clear();
            for (int j = 0; j * w + rem <= maxW; j++) {
                i64 t = f[j * w + rem] - 1LL * j * v;  // 取没有当前元素被影响的值
                while (!q.empty() && t >= q.back().first) q.pop_back(); /
                q.push_back({t, j}); 
                f[j * w + rem] = q.front().first + 1LL * j * v; // 更新答案
                if (j - q.front().second == num) q.pop_front(); // 窗口大小太大
            }
        }
    }
    return f[maxW];
} // O(n * maxW)
