        data pre = unit;
        for (int i = 0; i < m; i++) {
            int v = g[u][i];
            if (v == fa) continue;
            data mergedData = merge(movedFaData, merge(pre, suf[i + 1])); // 看v右兄弟的值
            reroot(v, u, moveEdge(mergedData, v, u, true)); // 递归下一层
            pre = merge(pre, moveEdge(subData[v], u, v, false)); // 把v加上去
