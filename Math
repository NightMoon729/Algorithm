#### 快速幂
```cpp
//快速幂组合数模板
const int MOD = 1'000'000'007;
const int MX = 100'001; 
i64 F[MX], INV_F[MX];
i64 qpow(i64 x, i64 n) {
    i64 res = 1;
    for (; n; n /= 2) {
        if (n % 2) {
            res = res * x % MOD;
        }
        x = x * x % MOD;
    }
    return res;
}

auto init = [] {
    F[0] = 1;
    for (int i = 1; i < MX; i++)
        F[i] = F[i - 1] * i % MOD;

    INV_F[MX - 1] = qpow(F[MX - 1], MOD - 2);
    for (int i = MX - 1; i; i--)
        INV_F[i - 1] = INV_F[i] * i % MOD;
    return 0;
}();

i64 comb(int n, int m) {
    return m < 0 || m > n ? 0 : F[n] * INV_F[m] % MOD * INV_F[n - m] % MOD;
}

```

#### lucas定理
```cpp
//lucas定理(处理模数m <= n or k的问题)
i64 lucas(i64 n, i64 k, int mod) {
    if (k == 0) return 1;
    return comb(n % mod, k % mod) * lucas(n / mod, k / mod, mod) % mod;
}
