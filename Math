#### 扩展欧几里得算法
```cpp
//exgcd（可以求出二元一次不定方程的一个特解）
i64 exgcd(i64 a, i64 b, i64 &x, i64 &y) { //ax + by = gcd(a, b) 裴蜀定理
    if (b == 0) {
        x = 1; y = 0;
        return a;
    }
    i64 d = exgcd(b, a % b, y, x);
    y -= (a / b) * x;
    return d;
} //O(log(n))
```

#### 中国剩余定理
```cpp 
//CRT（求一个同余方程组的一个解）
i64 crt(const std::vector<i64>& b, const std::vector<i64>& m) {
    i64 M = 1;
    for (i64 mi : m) M *= mi;
    i64 res = 0; //最终构造的答案
    for (int i = 0; i < m.size(); i++) {
        i64 mi = m[i]; //模数
        i64 Mi = M / mi; //要构建一个除了自己其他的都是0的数要用到所有的数
        i64 inv, y; //模意义上的逆元
        exgcd(Mi, mi, inv, y); //用到了扩展欧几里得
        res = (i64)(((i128)res + (i128)b[i] * Mi % M * inv) % M);
    }
    res = (res + M) % M;
    return res;
}
```

#### 欧拉定理
```cpp
//欧拉定理a ^ phi(m) ≡ (1 % m) 注:gcd(a, m) == 1
//欧拉函数（n 以内的与 n 互质的数的个数）
int calaPhi(int n) {
    int res = n;
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            res = res / i * (i - 1);
            while (n % i == 0) n /= i;
        }
    }
    if (n > 1) res = res / n * (n - 1);
    return res;
} //O(sqrt(n))


//预处理1 ~ MX的欧拉函数
int initPhi[MX];
auto init = [] {
    for (int i = 1; i < MX; i++) phi[i] = i;

    for (int i = 2; i < MX; i++)
        if (phi[i] == i)
            for (int j = i; j < MX; j += i)
                phi[j] = phi[j] / i * (i - 1);
    return 0;
}(); //O(nloglogn)


//扩展欧拉定理: 计算 a ^ b % mod, 不需要gcd(a, b) = 1
int exPhi(int a, int b, int m) {
    int phi = calaPhi(m);       // 计算 φ(m)
    if (b >= phi)             // 如果指数 >= φ(m)
        b = b % phi + phi;      // 降幂：b mod φ(m) + φ(m)
    return qpow(a, b, m);       // 快速幂计算 a^b mod m
} // O(sqrt(m) + logb)


bool parse_mod(std::string s, i64& n, int m) {
    bool flg = false;
    for (char c : s) {
        n = n * 10 + (c - '0');
        if (n >= m) {
            flg = true;
            n %= m;
        }
    }
    return flg;
}
i64 exPhiBigPow(std::string a, std::string b, int m) { //超大指数情形
    int phi = calaPhi(m);
    i64 exp = 0, bn = 0; 
    parse_mod(a, bn, m); //处理超大底数
    bool flg = parse_mod(b, exp, phi); //处理超大指数
    if (flg) exp += phi;
    return qpow(bn, exp, m) % m;
} // O(sqrt(m) + |b|)
