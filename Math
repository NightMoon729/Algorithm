#### 大步小步算法
```cpp
//BSGS
i64 babyStepGiantStep(i64 a, i64 b, i64 p, i64 k) {
    b %= p;
    i64 t = std::sqrt(p) + 1; // a ^ l = a ^ (tx + j)
    std::unordered_map<i64, i64> mp;
    for (i64 j = 0, x = b; j < t; ++j) { //枚举a ^ j
        mp[x] = j;
        x = x * a % p;
    }
    a = qpow(a, t, p); //转成a ^ t
    if (a == 0) {
        if (b == 0) return 1;
        return -99;
    }
    for (i64 i = 0, x = k; i < t; ++i) {
        if (mp.contains(x)) {
            i64 j = mp[x];
            if (i * t >= j) return i * t - j;
        }
        x = x * a % p;
    }
    return -99;
}
```

#### 莫比乌斯函数
``` cpp
//预处理莫比乌斯函数(调和级数写法)
int mu[MX];
std::vector<int> divisors[MX];
auto initMu = []{
    mu[1] = 1;
    for (int i = 1; i < MX; ++i)
        for (int j = i * 2; j < MX; j += i)
            mu[j] -= mu[i];

    for (int i = 1; i < MX; ++i) {
        if (mu[i] == 0) continue;

        for (int j = i; j < MX; j += i)
            divisors[j].push_back(i);
    }
    return 0;
}(); //O(nlogn)


//预处理莫比乌斯函数(线性筛写法)
constexpr int MX = 1e6 + 1;
int mu[MX];
std::vector<int> primes;
bool vis[MX];

auto init = [] {
    mu[1] = 1;
    for (int i = 2; i < MX; i++) {
        if (!vis[i]) {
            mu[i] = -1;
            primes.push_back(i);
        }
        for (int p : primes) {
            int v = p * i;
            if (v >= MX) break;
            vis[v] = true;
            if (i % p == 0) {
                mu[v] = 0;
                break;
            }
            mu[v] = -mu[i];
        }
    }
    return 0;
}; //O(n)
```

