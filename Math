//线性基模板
template <typename T>
class XorBasis {
    vector<T> b;
public:
    XorBasis (i32 n) : b(n) {}

    void insert(T x) {
        for (i32 i = b.size() - 1; i >= 0; i--) {
            if (x >> i) {
                if (b[i] == 0) {
                    b[i] = x;
                    return;
                }
                x ^= b[i];
            }
        }
    }

    T max_xor() {
        T res = {};
        for (i32 i = b.size() - 1; i >= 0; i--)
            res = max(res, res ^ b[i]);
        return res;
    }
};
```

# 计算几何
#### 凸包
``` cpp
struct Vec {
    int x, y;

    Vec sub(const Vec& b) const { // 求两点差
        return {x - b.x, y - b.y};
    }

    i64 det(const Vec& b) const { // 叉积公式
        return 1LL * x * b.y - 1LL * y * b.x;
    }
};

std::vector<Vec> convexHull(std::vector<Vec>& points) {
    std::ranges::sort(points, {}, [](auto& p) { return std::pair(p.x, p.y); });
    std::vector<Vec> q;

    for (auto& p : points) { // 计算下凸包（从左到右）
        while (q.size() > 1 && q.back().sub(q[q.size() - 2]).det(p.sub(q.back())) <= 0)
            q.pop_back();
        q.push_back(p);
    }

    int lower_size = q.size();
    for (auto& p : points | std::views::reverse) { // 计算上凸包（从右到左）
        while (q.size() > lower_size && q.back().sub(q[q.size() - 2]).det(p.sub(q.back())) <= 0)
            q.pop_back();
        q.push_back(p);
    }
    q.pop_back();
    return q;
}
```

