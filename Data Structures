#### 莫队
``` cpp
// 回滚莫队
std::vector<std::array<i64, 2>> moWithRollback(std::vector<int> a, std::vector<std::array<int, 2>> queries) {
    int n = a.size(), m = queries.size();
    std::vector<int> cnt(n + 1);
    i64 sum = 0, c = 0;
    auto add = [&](int i, int op) -> void { // 添加函数(根据题目修改)
        int k = a[i];
        auto& v = cnt[k];
        c -= 1LL * (v - 1) * v / 2;
        v += op ? 1 : -1;
        c += 1LL * (v - 1) * v / 2;
    };
    auto getAns = [&]() -> std::array<i64, 2> { // 获取答案函数(同上)
        if (sum == 0) return {1, 0};
        i64 g = std::gcd(sum, c);
        return {sum / g, c / g};
    };

    std::vector<std::array<i64, 2>> ans(m);
    int blockSize = std::ceil(n / std::sqrt(m));
    struct query {
        int bid, l, r, qid;
    };
    std::vector<query> qs;
    for (int i = 0; i < m; i++) {
        int l = queries[i][0], r = queries[i][1] + 1;
        if (r - l > blockSize) { // 大区间离线
            qs.emplace_back(l / blockSize, l, r, i);
            continue;
        }
        sum = 1LL * (r - l - 1) * (r - l) / 2;
        for (int j = l; j < r; j++) add(j, 1); // 小区间暴力
        ans[i] = getAns();
        for (int j = l; j < r; j++) cnt[a[j]] = 0; // 重置数据 ...
        sum = 0, c = 0;
    }

    std::ranges::sort(qs, [](query a, query b) {
        if (a.bid != b.bid) return a.bid < b.bid;
        return a.r < b.r;
    });

    int l = 0, r = 0;
    for (int i = 0; i < qs.size(); i++) {
        auto q = qs[i];
        int l0 = std::min((q.bid + 1) * blockSize, n);
        if (i == 0 || q.bid > qs[i - 1].bid) {
            l = l0, r = l0;
            std::ranges::fill(cnt, 0); // 重置数据 ...
            sum = 0, c = 0;
        }
        for (; r < q.r; r++) add(r, 1); // 右端点只往右
        for (; l > q.l; ) {
            --l;
            add(l, 1);
        }
        sum = 1LL * (q.r - q.l) * (q.r - q.l - 1) / 2;
        ans[q.qid] = getAns();
        for (; l < l0; l++) add(l, 0); // 回滚，始终保持 l 在 l0 的位置
    }
    return ans;
} // O(nsqrt(n))
