# 图论
#### 拓扑排序
``` cpp
std::vector<int> topologicalSort(int n, std::vector<std::vector<int>>& edges) {
    std::vector<std::vector<int>> g(n);
    std::vector<int> in_deg(n);
    for (auto& e : edges) {
        int x = e[0], y = e[1];
        g[x].push_back(y);
        in_deg[y]++; // 统计 y 的先修课数量
    }

    std::queue<int> q;
    for (int i = 0; i < n; i++) {
        if (in_deg[i] == 0)  // 没有先修课，可以直接上
            q.push(i); // 加入学习队列
    }

    std::vector<int> topo_order;
    while (!q.empty()) {
        int x = q.front();
        q.pop();
        topo_order.push_back(x);
        for (int y : g[x]) {
            in_deg[y]--; 
            if (in_deg[y] == 0) q.push(y); // 全部上完加入队列
        }
    }
    if (topo_order.size() < n) return {}; // 图中有环
    return topo_order;
} // O(n)
```

#### dijkstra
``` cpp 
std::vector<i64> shortestPathDijkstra(int n, std::vector<std::vector<int>>& edges, int start) {
    std::vector<std::vector<std::pair<int, int>>> g(n); // 邻接表
    for (auto& e : edges) {
        int x = e[0], y = e[1], wt = e[2];
        g[x].emplace_back(y, wt);
        // g[y].emplace_back(x, wt); // 无向图加上这行
    }

    std::vector<i64> dis(n, LLONG_MAX);
    // 堆中保存 (起点到节点 x 的最短路长度，节点 x)
    std::priority_queue<std::pair<i64, int>, std::vector<std::pair<i64, int>>, std::greater<>> pq;
    dis[start] = 0; // 起点到自己的距离是 0
    pq.emplace(0, start);
    while (!pq.empty()) {
        auto [dis_x, x] = pq.top();
        pq.pop();
        if (dis_x > dis[x]) continue;
        for (auto& [y, wt] : g[x]) {
            auto new_dis_y = dis_x + wt;
            if (new_dis_y < dis[y]) {
                dis[y] = new_dis_y; // 更新 x 的邻居的最短路
                pq.emplace(new_dis_y, y);
            }
        }
    }
    return dis;
} // O(mlogm)
```

#### 最小生成树 (kruskal算法)
``` cpp
int mstKruskal(int n, std::vector<std::array<int,3>>& edges) {
    std::ranges::sort(edges, [](const auto &a, const auto &b) {
        return a[2] < b[2];
    });
    std::vector<int> fa(n);
    std::ranges::iota(fa, 0);
    auto find = [&](this auto&& find, int x) -> int {
        return fa[x] == x ? x : fa[x] = find(fa[x]);
    };
    int sum = 0, cntE = 0;
    for (auto [u, v, w]: edges) {
        int fu = find(u), fv = find(v);
        if (fu != fv) {
            fa[fu] = fv;
            sum += w;
            cntE++;
        }
    }
    if (cntE < n - 1) return -1;
    return sum;
} // O(mlogm)
```

#### 二分图染色
``` cpp
bool isBipartite(std::vector<std::vector<int>>& graph) {
    std::vector<int8_t> colors(graph.size());
    auto dfs = [&](this auto&& dfs, int u, int8_t c) -> bool {
        colors[u] = c; // 节点 x 染成颜色 c
        for (int v : graph[u]) 
            if (colors[v] == c || colors[v] == 0 && !dfs(v, -c)) return false; 
        return true;
    };

    // 可能有多个连通块
    for (int i = 0; i < colors.size(); i++) 
       if (colors[i] == 0 && !dfs(i, 1)) return false; 
    return true;
} // O(n)
```

#### 二分图最大匹配(匈牙利算法)
``` cpp
std::pair<int, std::vector<int>> maxBipartiteMatchingHungarian(int nl, int nr, std::vector<std::vector<int>> &g) {
    int cnt = 0, ts = 0;
    std::vector<int> matchL(nl, -1), matchR(nr, -1), vis(nl);
    auto dfs = [&](this auto&& dfs, int u) -> bool {
        vis[u] = ts; // 时间戳
        for (int v : g[u]) {
            int w = matchR[v]; // 取得与v节点匹配的节点
            if (w == -1 || (vis[w] != ts && dfs(w))) { // 没有访问过或者改w节点的匹配
                matchR[v] = u;
                matchL[u] = v;
                return true;
            }
        }
        return false;
    };
    
    for (int u = 0; u < nl; u++) {
        ts++;
        if (dfs(u)) cnt++;
    }
    return {cnt, matchL};
}
 // O(nm)
```

#### 最大流(Dinic算法)
``` cpp
struct Dinic {
    struct Edge { i64 to, rid, cap; }; // 终点、反向边下标、剩余容量、原始边编号
    std::vector<std::vector<Edge>> g;
    std::vector<int> dis, iter; // 记录层数
    int st, ed; // 源点 汇点

    Dinic(int n, int st, int ed) : g(n), dis(n), iter(n), st(st), ed(ed) {} // 初始化

    void addEdge(int u, int v, int cap, int eid = -1) {
        g[u].push_back({v, (int)g[v].size(), cap});
        g[v].push_back({u, (int)g[u].size() - 1, 0});
    }

    bool bfs() {
        std::ranges::fill(dis, 0);
        std::queue<int> q;
        q.push(st);
        dis[st] = 1;
        while (!q.empty()) {
            int u = q.front();
            q.pop();
            for (auto &e : g[u]) {
                if (e.cap > 0 && !dis[e.to]) { // 如果容量大于0并且没被访问
                    dis[e.to] = dis[u] + 1;
                    q.push(e.to);
                }
            }
        }
        return dis[ed] > 0;
    }

    i64 dfs(int u, int flow) {
        if (u == ed) return flow; // 到达终点返回流量
        i64 res = 0; // 记录发出的流量
        for (; iter[u] < g[u].size(); iter[u]++) {
            auto &e = g[u][iter[u]];
            if (e.cap <= 0 || dis[e.to] != dis[u] + 1) continue; // 没有流量 or 层数不符合
            int f = dfs(e.to, std::min(flow - res, e.cap)); // 访问下一个点
            if (!f) continue;
            e.cap -= f;
            g[e.to][e.rid].cap += f;
            res += f;
            if (res == flow) break;
        }
        return res;
    }

    i64 maxFlow() {
        i64 ans = 0;
        while (bfs()) {
            std::ranges::fill(iter, 0);
            ans += dfs(st, inf);
        }
        return ans;
    }
};
